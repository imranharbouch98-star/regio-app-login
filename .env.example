# Bekijken (geen bewerkrechten) -- dit is enkel een lichte drempel, geen echte beveiliging
VITE_ACCESS_CODE=Bawaba

# Bewerken -- ENKEL gebruikt als fallback wanneer Firebase hieronder niet is
# ingesteld (lokaal testen zonder gedeelde database). Zodra Firebase actief is,
# logt de beheerder in met dit wachtwoord tegen het echte Firebase
# Authentication account hieronder, en wordt deze code genegeerd.
VITE_ADMIN_ACCESS_CODE=adminbawaba

# Voor gedeelde, live postcode-aanpassingen EN voor echte beveiliging van
# bewerkrechten (zie database.rules.json + README "Beveiliging")
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=

# E-mailadres van het ene gedeelde beheerder-account (Firebase Console ->
# Authentication -> Users). Het wachtwoord van dit account is wat je typt
# op het beheerder-loginscherm -- er wordt geen e-mail gevraagd.
VITE_FIREBASE_ADMIN_EMAIL=admin@regioapp.local
